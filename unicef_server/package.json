{
  "name": "unicef-server",
  "version": "1.0.0",
  "description": "ComMobi-Tracker REST API backend for UNICEF/MINPROFF Cameroon (SQLite -> API -> PostgreSQL -> Power BI)",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "db:setup": "npm run migrate && npm run seed"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "unicef",
    "minproff",
    "commobi-tracker",
    "cameroon",
    "api",
    "postgresql"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}