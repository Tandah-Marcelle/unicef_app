# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────
# Local install:  postgres://user:password@localhost:5432/unicef_tracker
# Docker compose: postgres://commobi:commobi@localhost:5432/commobi_tracker
DATABASE_URL=postgres://commobi:commobi@localhost:5432/commobi_tracker

# ── Auth ──────────────────────────────────────────────────
# Change this in production! Use: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*